{
  "master_directory": "pwd",
  "h5_path": "h5store/data-{:04d}.h5",
  "model_path": "models/model-{:04d}",
  "status_path": "status.txt",
  "builder_task": "alframework.builders.builders.simple_multi_condensed_phase_builder_task",
  "builder_config_path": "builder_config.json",
  "maximum_builder_structures": 256,
  "sampler_task": "alframework.samplers.batched_mlmd.mlmd_trajectories_task",
  "sampler_config_path": "mlmd_config.json",
  "QM_task": "alframework.qm_interfaces.teacher_interface.teacher_batch_task",
  "QM_config_path": "qm_config.json",
  "ML_task": "alframework.ml_interfaces.hippynn_interface.train_HIPPYNN_ensemble_multinode_task",
  "ML_config_path": "hippynn_config.json",
  "properties_list": {"energy": ["energy", "system", 1.0], "forces": ["forces", "atomic", 1.0]},
  "parallel_samplers": 16384,
  "target_queued_QM": 16384,
  "minimum_QM": 0,
  "save_h5_threshold": 16384,
  "bootstrap_set": 4096,
  "maximum_stored_labels": 65536,
  "gpus_per_node": 4,
  "parsl_configuration": "parsl_configs.config",
  "parsl_debug_configuration": "parsl_configs.config_debug",
  "run_report": true,
  "update_plots_every": 60,
  "scaling": {
    "parsl_data_serializer": "pickle",
    "poll_interval": 5,
    "coordinator_trim_after_snapshot": true,
    "disable_transparent_huge_pages": true,
    "label_storage_batch_size": 8192,
    "label_h5_layout": {"compression": "gzip", "level": 1, "shuffle": true, "frame_chunk": 1024},
    "trajectory_summary_path": "records/trajectories.jsonl",
    "coordinator_memory_sample": 30,
    "coordinator_memory_path": "records/coordinator_memory.csv",
    "coordinator_loop_path": "records/coordinator_loop.csv",
    "returned_metadata": "compact",
    "returned_momenta": false,
    "metadata_files": "per_task",
    "shared_training_data": true,
    "stream_final_evaluation": true
  }
}
